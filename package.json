{
  "name": "nezha-pixel-deck",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "A self-hosted pixel art status dashboard for Nezha v2",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/model.test.ts",
    "test:e2e": "playwright test",
    "check:privacy": "node scripts/check-privacy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
